# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Скопируйте этот файл в .env и укажите реальные значения.
# Файл .env строго запрещено коммитить в Git (добавлен в .gitignore)!

# --- Основные параметры приложения ---
APP_ENV=development               # development / staging / production
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_random_secret_key_32_bytes_min

# --- База Данных ---
DATABASE_URL=sqlite:///./app.db   # или postgresql://user:pass@localhost:5432/dbname

# --- Внешние сервисы и API (примеры) ---
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# OPENAI_API_KEY=sk-...
# SENTRY_DSN=https://...
